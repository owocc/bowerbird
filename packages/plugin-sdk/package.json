{
  "name": "@bowerbird/plugin-sdk",
  "version": "1.0.0-alpha",
  "description": "SDK for authoring Bowerbird preview and metadata plugins",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Bowerbird Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owocc/bowerbird.git",
    "directory": "packages/plugin-sdk"
  },
  "keywords": [
    "bowerbird",
    "plugin",
    "sdk",
    "preview",
    "metadata"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "typescript": "^5.2.2"
  }
}
