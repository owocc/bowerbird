{
  "name": "@bowerbird/plugin-sdk",
  "version": "2.1.0",
  "description": "TypeScript SDK for zero-build, native-rendered Bowerbird plugins",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Bowerbird Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owocc/bowerbird.git",
    "directory": "packages/plugin-sdk"
  },
  "keywords": [
    "bowerbird",
    "plugin",
    "sdk",
    "native",
    "mygo"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  }
}
