# URL to the plugin index file in the distribution repository
# e.g. https://raw.githubusercontent.com/<owner>/<repo>/main/index.min.json
# If left empty in local development, it will automatically fallback to reading ../dist/plugins/index.min.json
PLUGIN_REPO_INDEX_URL=https://raw.githubusercontent.com/owocc/bowerbird-plugins/main/index.min.json

# Base URL for downloading plugin release zip bundles
# e.g. https://github.com/<owner>/<repo>/releases/download/plugins-latest
# If left empty in local development, it will fallback to serving from ../dist/plugins/releases/
PLUGIN_RELEASE_BASE_URL=https://github.com/owocc/bowerbird-plugins/releases/download/plugins-latest

# Optional: GitHub Personal Access Token for private repo or higher rate limits
GITHUB_TOKEN=

# Optional: Cache TTL in seconds (default 300s)
PLUGIN_CACHE_TTL=300
