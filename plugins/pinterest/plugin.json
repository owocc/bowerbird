{
  "id": "official.pinterest",
  "name": "Pinterest",
  "version": "2.2.0",
  "minAppVersion": "1.0.0",
  "main": "index.js",
  "description": "Resolve Pinterest pin links to the original image without a build step.",
  "author": "Bowerbird Team",
  "permissions": {
    "network": [
      "pinterest.com",
      "*.pinterest.com",
      "pinterest.*",
      "*.pinterest.*",
      "pin.it",
      "*.pinimg.com",
      "pinterest.ru",
      "pinterest.co.kr"
    ],
    "process": [],
    "openExternal": true
  },
  "settings": [
    {
      "key": "cookie",
      "label": "Session Cookie (optional)",
      "help": "For private boards; sent only to pinterest.com.",
      "secret": true
    }
  ],
  "kind": "resolver",
  "priority": 55,
  "extensions": [],
  "mimePrefixes": [],
  "builtin": true,
  "hooks": [
    "resolveUrl",
    "inspect",
    "actions",
    "runAction"
  ],
  "capabilities": [
    "url-resolver",
    "metadata",
    "actions"
  ],
  "homepage": "https://github.com/owocc/bowerbird",
  "urlHosts": [
    "pinterest.com",
    "*.pinterest.com",
    "pinterest.*",
    "*.pinterest.*",
    "pin.it",
    "i.pinimg.com",
    "*.pinimg.com"
  ],
  "urlPatterns": [
    "^https?://(?:[a-z0-9-]+\\.)*pinterest\\.[a-z.]+/pin/\\d+",
    "^https?://(?:[a-z0-9-]+\\.)*pinterest\\.[a-z.]+/",
    "^https?://pin\\.it/[A-Za-z0-9]+",
    "^https?://i(?:-[a-z0-9]+)?\\.pinimg\\.com/"
  ]
}
