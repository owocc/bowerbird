{
  "name": "bowerbird-workspace",
  "version": "1.0.0-alpha-1",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/mygo.mjs dev",
    "dev:frontend": "pnpm --filter bowerbird dev",
    "dev:extension": "pnpm --filter bowerbird-web-extension dev",
    "dev:extension:firefox": "pnpm --filter bowerbird-web-extension dev:firefox",
    "dev:marketplace": "pnpm --filter bowerbird-marketplace dev",
    "dev:web": "pnpm --filter bowerbird-marketplace dev",
    "dev:docs": "pnpm --filter bowerbird-docs dev",
    "build": "pnpm run build:plugins && pnpm run build:frontend",
    "build:app": "node scripts/mygo.mjs build",
    "build:app:macos": "node scripts/mygo.mjs build -platform \"darwin/arm64,darwin/amd64\"",
    "build:app:macos:arm64": "node scripts/mygo.mjs build -platform darwin/arm64",
    "build:app:macos:x64": "node scripts/mygo.mjs build -platform darwin/amd64",
    "build:app:windows": "node scripts/mygo.mjs build -platform windows/amd64",
    "build:app:linux": "node scripts/mygo.mjs build -platform linux/amd64",
    "build:release": "pnpm run build:plugins && pnpm run build:frontend && node scripts/mygo.mjs build",
    "build:frontend": "pnpm --filter bowerbird build",
    "build:frontend:dev": "pnpm --filter bowerbird build:dev",
    "build:extension": "pnpm --filter bowerbird-web-extension build",
    "build:extension:firefox": "pnpm --filter bowerbird-web-extension build:firefox",
    "build:extension:edge": "pnpm --filter bowerbird-web-extension build:edge",
    "build:extension:safari": "pnpm --filter bowerbird-web-extension build:safari",
    "build:marketplace": "pnpm --filter bowerbird-marketplace build",
    "build:web": "pnpm --filter bowerbird-marketplace build",
    "build:docs": "pnpm --filter bowerbird-docs build",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build:sdk": "pnpm --filter @bowerbird/plugin-sdk build",
    "build:plugins": "node scripts/build-plugins.mjs",
    "build:all": "pnpm run build:packages && pnpm run build:plugins && pnpm run build:frontend && pnpm run build:extension && pnpm run build:marketplace && pnpm run build:docs",
    "preview:frontend": "pnpm --filter bowerbird preview",
    "preview:marketplace": "pnpm --filter bowerbird-marketplace preview",
    "preview:docs": "pnpm --filter bowerbird-docs preview",
    "typecheck": "pnpm -r --no-bail run typecheck --if-present",
    "check": "pnpm -r --no-bail run check --if-present",
    "test": "go test ./...",
    "test:watch": "go test -count=1 -v ./...",
    "zip:extension": "pnpm --filter bowerbird-web-extension zip",
    "zip:extension:firefox": "pnpm --filter bowerbird-web-extension zip:firefox",
    "zip:extension:safari": "pnpm --filter bowerbird-web-extension zip:safari",
    "deploy:marketplace": "pnpm --filter bowerbird-marketplace deploy",
    "deploy:docs": "pnpm --filter bowerbird-docs deploy",
    "clean": "rm -rf frontend/dist dist build/mygo apps/marketplace/dist apps/docs/dist",
    "reset": "pnpm run clean && pnpm install"
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  }
}
